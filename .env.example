# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
# You can define multiple keys for automatic load balancing and failover rotation (optional):
API_KEY=your_groq_api_key_here
API_KEY_1=another_groq_api_key_1
API_KEY_2=another_groq_api_key_2
API_KEY_3=another_groq_api_key_3

# Optional: Set default language
# Options: English, Hindi, Kannada, Tamil, Telugu
DEFAULT_LANGUAGE=English

# Video asset fetching and verification
SERPAPI_API_KEY=
GROQ_API_KEY=
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
ASSET_CACHE_DIR=video_generation/assets/cache
ASSET_GALLERY_DIR=storage/asset_candidate_gallery
ASSET_MIN_CONFIDENCE=0.80
ASSET_ENABLE_WEB_FETCH=true
ASSET_ENABLE_VISION_VERIFY=true
ASSET_ENABLE_OCR_VERIFY=true
